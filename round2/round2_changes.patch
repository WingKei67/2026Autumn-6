+    v=f.update(obs(10,110.,(event,)))['AAPL'].copy()
+    assert abs(v[I['r3']]-(110/107-1))<1e-12
+    assert abs(v[I['ann_remaining']]-(109*1.1/110-1))<1e-12
+    f.update(obs(11,100000.))
+    assert abs(v[I['ann_remaining']]-(109*1.1/110-1))<1e-12
+
