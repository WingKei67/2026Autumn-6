+            for i,fu in enumerate(as_completed([pool.submit(job,j) for j in jobs]),1):
+                r=fu.result();f.write(json.dumps(r,allow_nan=False)+'\n');f.flush()
+                print(i,len(jobs),r['week'],r['strategy'],round(r['pnl'],2),flush=True)
