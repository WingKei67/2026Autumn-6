+def test_actual_bot_real_exchange_halt_resume_and_fills(monkeypatch, tmp_path, seat):
+    """Real matching/risk and wire dispatch; in-memory transport, no live accounts."""
+    async def run():
+        monkeypatch.setattr(tc, 'TEAM_ID', seat)
