classDiagram
    direction TB

    class Trader {
        <<abstract>>
        +on_tick(market, portfolio) Signal*
        +on_fill(side, symbol, quantity, price)
        +on_event(event, message, data)
        +on_ipo(symbol, lo, hi, shares, data)
        +run()
    }
    class MyTrader {
        +on_tick(market, portfolio) Signal
        +on_fill(side, symbol, quantity, price)
        +on_event(event, message, data)
    }
    class Broker {
        +spread(symbol, price, history)
        +skew(symbol, inventory)
        +toxic(trader_id)
        +on_fill(side, symbol, quantity, price)
        +run()
    }
    class MyBroker {
        +spread(symbol, price, history)
        +skew(symbol, inventory)
    }
    class Exchange {
        +taker_bps
        +rebate_bps
        +accept_order(order, portfolio)
        +on_trade(symbol, price, quantity, buyer_id, seller_id)
        +run()
    }

    class MarketData {
        +symbols()
        +mid_price(s)
        +best_bid(s)
        +best_ask(s)
        +prices(s)
    }
    class Portfolio {
        +cash
        +positions
        +can_buy(s, qty, px)
        +can_sell(s, qty)
    }
    class Signal {
        +symbol
        +side
        +quantity
        +price
    }

    class TraderBot {
        <<engine>>
        +market
        +portfolio
    }
    class ExchangeServer {
        <<hosted arena>>
    }

    class Handshake {
        <<message>>
        +direction: client to exchange
        +team_id
        +role
        +token
    }
    class PlaceOrder {
        <<message>>
        +direction: client to exchange
        +symbol
        +side
        +order_type
        +price
        +quantity
    }
    class CancelOrder {
        <<message>>
        +direction: client to exchange
        +order_id
        +symbol
    }
    class OrderAck {
        <<message>>
        +direction: exchange to client
        +order_id
        +symbol
        +side
        +price
        +quantity
    }
    class BookSnapshot {
        <<message>>
        +direction: exchange to client
        +symbol
        +bids
        +asks
        +mid_price
    }

    Trader <|-- MyTrader : extends
    Broker <|-- MyBroker : extends

    Trader ..> MarketData : on_tick arg
    Trader ..> Portfolio : on_tick arg
    Trader ..> Signal : on_tick returns

    TraderBot o-- Trader : calls hooks
    TraderBot *-- MarketData
    TraderBot *-- Portfolio
    Exchange ..> ExchangeServer : adapts

    TraderBot ..> Handshake : sends
    TraderBot ..> PlaceOrder : sends
    TraderBot ..> CancelOrder : sends
    ExchangeServer ..> OrderAck : sends
    ExchangeServer ..> BookSnapshot : sends

    note for MyTrader "overrides on_tick, on_fill, on_event / inherits on_ipo, run"
    note for MyBroker "overrides spread, skew / inherits toxic, on_fill, run"
